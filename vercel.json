{
  "buildCommand": "PORT=3000 BASE_PATH=/ pnpm --filter @workspace/app run build",
  "outputDirectory": "artifacts/app/dist/public",
  "installCommand": "pnpm install --ignore-scripts && pnpm add -D @rollup/rollup-linux-x64-gnu --workspace-root",
  "framework": null,
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
